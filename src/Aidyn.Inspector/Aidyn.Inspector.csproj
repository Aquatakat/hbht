<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aidyn.Inspector</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The editor reads plugins (ADR 0010). Aidyn.Rom is only for running the importer and reading checkpoints, which needs no ROM. -->
    <ProjectReference Include="..\Aidyn.Core\Aidyn.Core.csproj" />
    <ProjectReference Include="..\Aidyn.Plugins\Aidyn.Plugins.csproj" />
    <ProjectReference Include="..\Aidyn.Rom\Aidyn.Rom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime's, so the editor plays actors and draws map sets as the game does (ADR 0010). -->
    <Compile Include="..\Aidyn.Game\ActorAnimator.cs" Link="Shared\ActorAnimator.cs" />
    <Compile Include="..\Aidyn.Game\Billboards.cs" Link="Shared\Billboards.cs" />
    <Compile Include="..\Aidyn.Game\ChunkScenery.cs" Link="Shared\ChunkScenery.cs" />
    <Compile Include="..\Aidyn.Game\ConversationBoxView.cs" Link="Shared\ConversationBoxView.cs" />
    <Compile Include="..\Aidyn.Game\FrameCallback.cs" Link="Shared\FrameCallback.cs" />
    <Compile Include="..\Aidyn.Game\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\Aidyn.Game\Nodes.cs" Link="Shared\Nodes.cs" />
    <Compile Include="..\Aidyn.Game\PartyTabView.cs" Link="Shared\PartyTabView.cs" />
    <Compile Include="..\Aidyn.Game\TextureScrolls.cs" Link="Shared\TextureScrolls.cs" />
    <Compile Include="..\Aidyn.Game\UiImages.cs" Link="Shared\UiImages.cs" />
    <Compile Include="..\Aidyn.Game\UiPainter.cs" Link="Shared\UiPainter.cs" />
    <Compile Include="..\Aidyn.Game\UiScreen.cs" Link="Shared\UiScreen.cs" />
    <Compile Include="..\Aidyn.Game\Vectors.cs" Link="Shared\Vectors.cs" />
  </ItemGroup>

</Project>

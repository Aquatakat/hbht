; Engine configuration file.

config_version=5

[application]

config/name="HBHT Editor"
run/main_scene="res://Main.tscn"
config/version="0"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"

[dotnet]

project/assembly_name="HBHT.Editor"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

textures/vram_compression/import_etc2_astc=true
limits/global_shader_variables/buffer_size=1048576

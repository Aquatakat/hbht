<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aidyn.Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin format and the rules core: the runtime never reads the ROM (ADR 0001), and the build enforces it. -->
    <ProjectReference Include="..\Aidyn.Core\Aidyn.Core.csproj" />
    <ProjectReference Include="..\Aidyn.Plugins\Aidyn.Plugins.csproj" />
  </ItemGroup>

</Project>

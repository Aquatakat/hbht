<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- The test classes run side by side on every core and allocate hard (each builds battles and games of its own): a heap per
         core collects in parallel, where the one workstation heap stopped every test for each collection. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Saves\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="HBHT.TestSupport" />
    <Using Include="HBHT.TestSupport.Ids" Static="true" />
    <Using Include="HBHT.TestSupport.Checks" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HBHT.TestSupport\HBHT.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\HBHT.Core\HBHT.Core.csproj" />
    <ProjectReference Include="..\..\src\HBHT.Rom\HBHT.Rom.csproj" />
  </ItemGroup>

</Project>
